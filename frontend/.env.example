# Firebase project for sign-in and sync — copy this file to .env.production.local (and to
# .env.local for `npm run dev`) and fill in the values from Firebase console → Project settings →
# General → "Your apps" → Web app → SDK setup and configuration → Config.
# These are public identifiers, not secrets (access is controlled by firestore.rules), but they
# are specific to your own instance, so the .local files are kept out of git.
#
# Leave them empty to build the local-only version: no accounts, everything in the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
